+++ b/vllm/models/inkling2/nvidia/ops/dspark.py
@@ -64,12 +64,49 @@ def mix_rmsnorm(
     return out
 
 
+@triton.jit
+def _add_rms_norm_kernel(
+    X, RES, W, N: tl.constexpr, EPS: tl.constexpr, HAS_RES: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0).to(tl.int64)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < N
+    x = tl.load(X + row * N + cols, mask, other=0).to(tl.float32)
+    if HAS_RES:
+        x += tl.load(RES + row * N + cols, mask, other=0).to(tl.float32)
+        tl.store(RES + row * N + cols, x.to(RES.dtype.element_ty), mask)
+    inv_rms = tl.rsqrt(tl.sum(x * x, 0) / N + EPS)
+    w = tl.load(W + cols, mask, other=0).to(tl.float32)
+    tl.store(X + row * N + cols, (x * inv_rms * w).to(X.dtype.element_ty), mask)
+
