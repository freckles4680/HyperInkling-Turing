+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperInkling W8A16 linears: bf16 weights quantized at load time to int8
+(symmetric, one bf16 scale per 128 inputs of each output channel), run by
+a Triton GEMV/GEMM kernel.
+
+The weight keeps the natural `[N, K]` layout, so slicing rows stays free
+and full layers can project q, k and v (different inputs) in one launch:
+`W8Linear.multi` stacks the inputs, reads the weight once and returns each
+input's column range. Decode is bandwidth bound, so the extra rows cost
+little. Prefill (many rows) runs the same kernel with larger row tiles.
+
+Group-128 int8 round-to-nearest needs no calibration and works on the
+released checkpoint as is.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+from . import is_sm75
+
+GROUP = 128
+
+
+def quantize_int8(weight: torch.Tensor):
+    """bf16 `[N, K]` -> int8 codes `[N, K]` and bf16 scales `[N, K / GROUP]`.
+
+    Row-wise, in chunks of 4096 rows: the fp32 temporaries of a whole LM head
+    (201k x 2304) took ~5.5 GB at load, past a 22 GB card's free memory."""
+    n, k = weight.shape
+    q = torch.empty((n, k), dtype=torch.int8, device=weight.device)
+    scale = torch.empty((n, k // GROUP), dtype=torch.bfloat16, device=weight.device)
+    for start in range(0, n, 4096):
+        rows = slice(start, start + 4096)
+        g = weight[rows].float().unflatten(1, (-1, GROUP))
+        s = (g.abs().amax(-1) / 127.0).clamp_min(1e-10).to(torch.bfloat16)
+        scale[rows] = s
+        q[rows] = (g / s.float()[..., None]).round().clamp(-127, 127).flatten(1).to(torch.int8)
+    return q, scale
+
+
+def dequantize_int8(q: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    return (q.float().unflatten(1, (-1, GROUP)) * scale.float()[..., None]).flatten(1)
+
+
+@triton.jit
+def _w8_kernel(
+    X, W, S, Y, M, N, K, SX, SW, SS, SY,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr,
+):  # fmt: skip
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    rows = pid_m * BM + tl.arange(0, BM)
+    cols = pid_n * BN + tl.arange(0, BN)
+    col_ok = cols < N
+    acc = tl.zeros((BM, BN), tl.float32)
+    for g in range(0, tl.cdiv(K, BK)):
+        ks = g * BK + tl.arange(0, BK)
+        w = tl.load(
+            W + cols[None, :].to(tl.int64) * SW + ks[:, None],
+            col_ok[None, :],
+            other=0,
+        )
+        x = tl.load(
+            X + rows[:, None].to(tl.int64) * SX + ks[None, :],
+            rows[:, None] < M,
+            other=0,
+        )
+        s = tl.load(S + cols.to(tl.int64) * SS + g, col_ok, other=0).to(tl.float32)
+        acc += tl.dot(x, w.to(X.dtype.element_ty)) * s[None, :]
+    tl.store(
+        Y + rows[:, None].to(tl.int64) * SY + cols[None, :],
+        acc.to(Y.dtype.element_ty),
+        (rows[:, None] < M) & col_ok[None, :],
+    )
+
+
+@triton.jit
+def _w8_gemv_kernel(
+    X, W, S, Y, M, N, K, KS, SX, SW, SS, SY, BX, BW, BY, XP,
+    BM: tl.constexpr, BN: tl.constexpr, BK: tl.constexpr, GROUP_K: tl.constexpr,
+    HAS_SCALE: tl.constexpr, SPLIT: tl.constexpr, NX: tl.constexpr,
+):  # fmt: skip
+    """Turing: Triton emits no tensor-core MMA for sm75, and `tl.dot` there runs
+    as FMA through shared memory (~2 ms a call on a 2080 Ti). Small row counts
+    as plain FMAs instead: x and the scaled weight are loaded straight into a
+    3D `[BM, BN, BK]` layout (no layout conversion), products accumulate
+    elementwise, and K is reduced once at the end. Without HAS_SCALE, W is a
+    plain bf16/fp16 weight (the K-group linears and the router). Axis 2 runs
+    batches (strides BX, BW) times SPLIT slices of KS along K; each writes its
+    own `[M, N]` at Y + axis 2 * BY (the loop controllers). x is the sum, in
+    order, of NX partials XP apart (the previous call's K slices)."""
+    pid_n = tl.program_id(0)
+    pid_m = tl.program_id(1)
+    pid_b = tl.program_id(2)
+    X += (pid_b // SPLIT).to(tl.int64) * BX
+    W += (pid_b // SPLIT).to(tl.int64) * BW
+    Y += pid_b.to(tl.int64) * BY
+    k_lo = (pid_b % SPLIT) * KS
+    k_hi = tl.minimum(k_lo + KS, K)
+    rows = pid_m * BM + tl.arange(0, BM)
+    cols = pid_n * BN + tl.arange(0, BN)
+    r3 = rows[:, None, None]
+    c3 = cols[None, :, None]
+    row_ok = r3 < M
+    col_ok = c3 < N
+    acc = tl.zeros((BM, BN, BK), tl.float32)
+    for k0 in range(k_lo, k_hi, BK):
+        k3 = k0 + tl.arange(0, BK)[None, None, :]
+        w = tl.load(W + c3.to(tl.int64) * SW + k3, col_ok, other=0).to(tl.float32)
+        if HAS_SCALE:
+            s = tl.load(S + c3.to(tl.int64) * SS + k0 // GROUP_K, col_ok, other=0)
+            w = w * s.to(tl.float32)
+        x = tl.load(X + r3.to(tl.int64) * SX + k3, row_ok, other=0).to(tl.float32)
+        for p in tl.static_range(1, NX):
+            x += tl.load(X + p * XP + r3.to(tl.int64) * SX + k3, row_ok, other=0).to(tl.float32)
+        acc += x * w
+    out = tl.sum(acc, axis=2)
+    rows2 = pid_m * BM + tl.arange(0, BM)
+    cols2 = pid_n * BN + tl.arange(0, BN)
+    tl.store(
+        Y + rows2[:, None].to(tl.int64) * SY + cols2[None, :],
+        out.to(Y.dtype.element_ty),
+        (rows2[:, None] < M) & (cols2[None, :] < N),
+    )
+
+
+# Turing: up to this many rows on `_w8_gemv_kernel`; above, dequantized blocks of
+# rows on cuBLAS (fp16 tensor cores).
+SM75_GEMV_MAX_M = 64
+
+
+def sm75_gemv_tile(m: int, n: int) -> tuple[int, int, int, int]:
+    """(BM, BN, BK, warps) of `_w8_gemv_kernel`, from bench/sm75_w8_gemv.py on a
+    2080 Ti (L2-cold INT8 weights, K 2304): few accumulators (1-2k fp32) beat
+    big tiles 2-4x, as many blocks keep more loads in flight. 1 row: 565 GB/s
+    on the LM head (the card's peak is 616). 3-4 rows were not measured."""
+    if m == 1:
+        return 1, 8, 128, 8
+    if m == 2:
+        return 2, 8, 64, 8
+    if m <= 4:
+        return 4, 4, 64, 4
+    return 8, 4 if n >= 32768 else 2, 128, 1
+
+
+def gemv_sm75(x, w, scale, out, tile):
+    """`out = x @ w.T` on `_w8_gemv_kernel`: INT8 `w` with its group `scale`, or
+    a bf16/fp16 `w` with `scale` None. `out` may be fp32."""
+    m, k = x.shape
+    bm, bn, bk, warps = tile
+    assert k % bk == 0 and x.stride(1) == 1 and w.stride(1) == 1
+    grid = (triton.cdiv(w.shape[0], bn), triton.cdiv(m, bm), 1)
+    _w8_gemv_kernel[grid](
+        x, w, w if scale is None else scale, out, m, w.shape[0], k, k,
+        x.stride(0), w.stride(0), 0 if scale is None else scale.stride(0), out.stride(0),
+        0, 0, 0, 0,
+        BM=bm, BN=bn, BK=bk, GROUP_K=GROUP, HAS_SCALE=scale is not None, SPLIT=1, NX=1,
+        num_warps=warps, num_stages=1,
+    )  # fmt: skip
+    return out
+
+
+def bgemv_sm75(x, w, split=1):
+    """Batched `x (B, M, K) @ w (B, N, K).T` -> fp32 `(B, split, M, N)`, K cut
+    in `split` slices (the loop controllers' rank-R down projection has too few
+    outputs to fill the GPU otherwise). `x` may be fp32, or `(B, P, M, K)`
+    partials (a split call's output), summed in order as they load."""
+    x4 = x if x.ndim == 4 else x[:, None]
+    b, nx, m, k = x4.shape
+    n = w.shape[1]
+    assert w.shape == (b, n, k) and x4.stride(3) == 1 and w.stride(2) == 1
+    bm, bn, bk, warps = sm75_gemv_tile(m, n)
+    while k % bk:  # same accumulator count with a K step that divides K
+        bk, bn = bk // 2, bn * 2
+    ks = triton.cdiv(triton.cdiv(k, split), bk) * bk
+    out = torch.empty((b, split, m, n), dtype=torch.float32, device=x.device)
+    grid = (triton.cdiv(n, bn), triton.cdiv(m, bm), b * split)
+    _w8_gemv_kernel[grid](
+        x, w, w, out, m, n, k, ks,
+        x4.stride(2), w.stride(1), 0, out.stride(2), x4.stride(0), w.stride(0), out.stride(1),
+        x4.stride(1),
+        BM=bm, BN=bn, BK=bk, GROUP_K=GROUP, HAS_SCALE=False, SPLIT=split, NX=nx,
+        num_warps=warps, num_stages=1,
+    )  # fmt: skip
+    return out
+
+
+def controller_gemv_sm75(x, down, up):
+    """Turing: the loop controllers' `bmm(bmm(x, down.T), up.T)` in fp32 for
+    decode rows (as ops.bgemv.controller_gemv, whose `tl.dot` runs on FMA
+    through shared memory there): the down projection in 8 K slices, which the
+    up projection sums in fp32, in order, as it loads them."""
+    return bgemv_sm75(bgemv_sm75(x, down, split=8), up)[:, 0]
+
+
+def w8_gemv_sm75(x, q, scale, out, tile):
+    return gemv_sm75(x, q, scale, out, tile)
+
+
+def _w8_matmul_sm75(x, q, scale, out):
+    m, k = x.shape
+    n = q.shape[0]
+    if m <= SM75_GEMV_MAX_M:
+        return w8_gemv_sm75(x, q, scale, out, sm75_gemv_tile(m, n))
+    for start in range(0, n, 8192):
+        rows = slice(start, start + 8192)
+        w = (
+            q[rows].to(x.dtype).unflatten(1, (-1, GROUP)) * scale[rows].to(x.dtype)[..., None]
+        ).flatten(1)
+        out[:, rows] = x @ w.T
+    return out
+
+
+def w8_matmul(
+    x: torch.Tensor,
+    q: torch.Tensor,
+    scale: torch.Tensor,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """`x [M, K] bf16/fp16 @ dequant(q, scale).T` -> `[M, N]` of `x`'s dtype."""
+    m, k = x.shape
+    n = q.shape[0]
+    assert k % GROUP == 0 and q.shape[1] == k and x.stride(1) == 1
+    if out is None:
+        out = torch.empty((m, n), dtype=x.dtype, device=x.device)
+    if m == 0:
+        return out
+    if is_sm75():
+        return _w8_matmul_sm75(x, q, scale, out)
+    # Tiles tuned on an RTX 3090 Ti (L2-cold weights, bench/w8_gemv.py;
+    # tests/test_linear_w8.py covers every branch). Decode: one row tile, column
+    # tiles narrow enough to spread the weight over every SM. Verify steps
+    # (requests x (1 + drafts): 3-128 rows) have their own tiles; above 128 rows,
+    # the prefill tile. Four widths: k/v (<= 1024), o (< 4096), qkvr and the
+    # query side (< 32768), the LM head.
+    size = 0 if n <= 1024 else 1 if n < 4096 else 2 if n < 32768 else 3
+    if m == 1:
+        tiles = ((16, 16, 2, 4), (16, 16, 2, 4), (16, 32, 4, 3), (16, 128, 8, 5))
+    elif m <= 12:
+        tiles = ((16, 32, 4, 4), (16, 32, 4, 4), (16, 32, 4, 3), (16, 128, 8, 5))
+    elif m <= 32:
+        tiles = ((16, 32, 4, 3), (16, 64, 8, 3), (32, 128, 8, 3), (32, 64, 4, 2))
+    elif m <= 64:
+        tiles = ((32, 32, 8, 3), (32, 64, 4, 3), (32, 128, 4, 3), (64, 128, 4, 2))
+    elif m <= 128:
+        tiles = ((32, 64, 4, 3), (32, 128, 8, 3), (64, 256, 8, 3), (128, 128, 8, 2))
+    else:
+        tiles = ((64, 256, 8, 3),) * 4
+    bm, bn, warps, stages = tiles[size]
+    grid = (triton.cdiv(n, bn), triton.cdiv(m, bm))
+    _w8_kernel[grid](
+        x, q, scale, out, m, n, k,
+        x.stride(0), q.stride(0), scale.stride(0), out.stride(0),
+        BM=bm, BN=bn, BK=GROUP, num_warps=warps, num_stages=stages,
+    )  # fmt: skip
+    return out
+
+
+class W8Linear:
+    """`x @ weight.T` for a bf16 `weight [N, K]`, as int8 W8A16."""
+
+    def __init__(self, weight: torch.Tensor) -> None:
+        self.size_n, self.size_k = weight.shape
+        self.q, self.scale = quantize_int8(weight)
+
+    def __call__(
+        self, x: torch.Tensor, out: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        return w8_matmul(x.contiguous(), self.q, self.scale, out)
+
+    def multi(
+        self, inputs: list[torch.Tensor], col_ranges: list[tuple[int, int]]
+    ) -> list[torch.Tensor]:
+        """`inputs[i] @ weight[col_ranges[i]].T` for each i, reading the weight
+        once when the stacked rows fit one decode tile, else one launch each."""
+        rows = [x.shape[0] for x in inputs]
+        if sum(rows) <= 32:
+            y = w8_matmul(torch.cat(inputs), self.q, self.scale)
+            out, start = [], 0
+            for r, (lo, hi) in zip(rows, col_ranges):
+                out.append(y[start : start + r, lo:hi])
+                start += r
+            return out
+        return [
+            w8_matmul(x.contiguous(), self.q[lo:hi], self.scale[lo:hi])
+            for x, (lo, hi) in zip(inputs, col_ranges)
+        ]
