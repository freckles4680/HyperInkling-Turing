--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/attention_sm75.py
@@ -0,0 +1,304 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperInkling, Turing (sm75): relative-bias paged attention on the fp16
+tensor cores, a CUDA kernel outside the vLLM build.
+
+Triton emits no tensor-core MMA for sm75: `_rel_attention_kernel` runs its dots
+as FMA through shared memory there (on a 2080 Ti, 74% of an 8k prefill and
+~43 ms of a decode step at 90k tokens, whose KV reads take ~3 ms at the card's
+bandwidth). `kernels/sm75/rel_attention.cu`
+of the HyperInkling repository does the same work with `wmma`;
+`scripts/build-sm75-kernels.sh` compiles it into `venv/hyperinkling_sm75.so`,
+which `start.sh` passes as HYPERINKLING_SM75_LIB. Without the library the
+Triton kernel serves.
+"""
+
+import ctypes
+import functools
+import os
+
+import torch
+
+from vllm.logger import init_logger
+
+from . import is_sm75
+
+logger = init_logger(__name__)
+
+ROWS = 16  # of a warp; a block has 1, 2, 4 or 8 warps
+MAX_ROWS = 64
+HEAD_DIM = 128
+MODE_OUT_LSE = 0
+MODE_PARTIAL = 2
+_ABI = 5
+
+
+class _Args(ctypes.Structure):
+    _fields_ = [
+        ("q", ctypes.c_void_p),
+        ("k", ctypes.c_void_p),
+        ("v", ctypes.c_void_p),
+        ("rel", ctypes.c_void_p),
+        ("block_table", ctypes.c_void_p),
+        ("seq_lens", ctypes.c_void_p),
+        ("cu_seqlens_q", ctypes.c_void_p),
+        ("out", ctypes.c_void_p),
+        ("lse", ctypes.c_void_p),
+        ("stride_q_t", ctypes.c_int64),
+        ("stride_kv_blk", ctypes.c_int64),
+        ("stride_kv_slot", ctypes.c_int64),
+        ("stride_kv_h", ctypes.c_int64),
+        ("stride_rel_t", ctypes.c_int64),
+        ("stride_bt", ctypes.c_int64),
+        ("stride_out_t", ctypes.c_int64),
+        ("stride_out_h", ctypes.c_int64),
+        ("stride_lse_h", ctypes.c_int64),
+        ("stride_lse_t", ctypes.c_int64),
+        ("softmax_scale", ctypes.c_float),
+        ("num_tokens", ctypes.c_int32),
+        ("num_splits", ctypes.c_int32),
+        ("num_kv_heads", ctypes.c_int32),
+        ("num_heads", ctypes.c_int32),
+        ("group", ctypes.c_int32),
+        ("extent", ctypes.c_int32),
+        ("page", ctypes.c_int32),
+        ("page_shift", ctypes.c_int32),
+        ("window", ctypes.c_int32),
+        ("draft", ctypes.c_int32),
+        ("mode", ctypes.c_int32),
+    ]
+
+
+def load_library(path: str) -> ctypes.CDLL:
+    lib = ctypes.CDLL(path)
+    lib.hi_sm75_abi.restype = ctypes.c_int
+    if lib.hi_sm75_abi() != _ABI:
+        raise RuntimeError(
+            f"{path} is from another HyperInkling version: "
+            "run scripts/build-sm75-kernels.sh again"
+        )
+    lib.hi_sm75_rel_attention.restype = ctypes.c_int
+    lib.hi_sm75_rel_attention.argtypes = [
+        ctypes.POINTER(_Args),
+        ctypes.c_int,
+        ctypes.c_int,
+        ctypes.c_int,
+        ctypes.c_void_p,
+    ]
+    return lib
+
+
+@functools.cache
+def _library() -> ctypes.CDLL | None:
+    path = os.environ.get("HYPERINKLING_SM75_LIB", "")
+    if not path:
+        return None
+    lib = load_library(path)
+    logger.info("HyperInkling: sm75 tensor-core attention from %s", path)
+    return lib
+
+
+def available() -> bool:
+    """Whether the sm75 attention library is configured (HYPERINKLING_SM75_LIB)."""
+    return _library() is not None
+
+
+def takes_heads(num_heads: int, num_kv_heads: int) -> bool:
+    """Whether the library is there and has blocks for this GQA group."""
+    return (
+        available()
+        and num_heads % num_kv_heads == 0
+        and num_heads <= ROWS * num_kv_heads
+    )
+
+
+def decode_warps(max_query_len: int, group: int) -> int:
+    """Warps of a decode block: the fewest whose rows hold a request's tokens."""
+    return next((w for w in (1, 2) if max_query_len <= w * ROWS // group), 4)
+
+
+def splits_per_sm(max_query_len: int, group: int) -> int:
+    """Blocks per SM of a full layer's decode attention, by the block's warps
+    (12.7, 17 and 26 KB of Turing's 64 KB of shared memory): measured on a
+    2080 Ti at 90k tokens, five one-warp blocks (1.5 ms a launch; four: 1.9 ms)
+    and three two-warp blocks (2.0 ms; four: 2.8 ms). HYPERINKLING_SM75_ATTN_CTAS
+    to measure others."""
+    forced = os.environ.get("HYPERINKLING_SM75_ATTN_CTAS")
+    if forced:
+        return int(forced)
+    return {1: 5, 2: 3, 4: 2}[decode_warps(max_query_len, group)]
+
+
+def prefill_warps(window: int) -> int:
+    """Warps of a prefill block: four (64 rows), or with
+    HYPERINKLING_SM75_PREFILL_WARPS=8 eight for the full layers, whose blocks
+    then read each key half as often."""
+    return (
+        int(os.environ.get("HYPERINKLING_SM75_PREFILL_WARPS", "4"))
+        if window == 0
+        else 4
+    )
+
+
+def _refusal(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    max_query_len: int,
+    index: tuple[torch.Tensor, ...],
+    partial: bool,
+) -> str | None:
+    """Why `rel_attention_sm75` does not take this launch, or None if it does."""
+    if not available():
+        return "HYPERINKLING_SM75_LIB is not set (scripts/build-sm75-kernels.sh)"
+    num_heads, head_dim = q.shape[1:]
+    group = num_heads // key_cache.shape[2]
+    if head_dim != HEAD_DIM or not takes_heads(num_heads, key_cache.shape[2]):
+        return f"head dim {head_dim}, {group} heads per KV head"
+    if partial and max_query_len > MAX_ROWS // group:
+        return f"{max_query_len} tokens per request"
+    if q.dtype != torch.float16 or q.stride()[1:] != (head_dim, 1):
+        return f"queries {q.dtype}, strides {tuple(q.stride())}"
+    if key_cache.dtype != torch.uint8:
+        return f"KV cache {key_cache.dtype}"
+    if any(tensor.dtype != torch.int32 for tensor in index):
+        return f"index tensors {[tensor.dtype for tensor in index]}"
+    return None
+
+
+@functools.cache
+def _log_route(partial: bool, refusal: str | None) -> None:
+    if refusal is None or available() or is_sm75():
+        logger.info(
+            "HyperInkling: sm75 attention, %s: %s",
+            "decode partials" if partial else "prefill",
+            "tensor cores" if refusal is None else f"Triton kernel ({refusal})",
+        )
+
+
+def supports(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    max_query_len: int,
+    *index: torch.Tensor,
+    partial: bool,
+) -> bool:
+    """Whether `rel_attention_sm75` takes this launch (else the Triton kernel):
+    fp16 queries over an E4M3 byte cache with int32 `index` tensors (block
+    table, lengths); split partials (`partial`) of at most 64 rows a request
+    and KV head, or the single-split output and LSE of any number of rows.
+    The first launch of each kind and outcome is logged."""
+    refusal = _refusal(q, key_cache, max_query_len, index, partial)
+    _log_route(partial, refusal)
+    return refusal is None
+
+
+def rel_attention_sm75(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    out: torch.Tensor,
+    lse: torch.Tensor,
+    rel_logits: torch.Tensor | None,
+    *,
+    block_table: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    max_query_len: int,
+    softmax_scale: float,
+    window: int,
+    num_splits: int,
+    mode: int,
+    lib: ctypes.CDLL | None = None,
+    warps: int | None = None,
+) -> None:
+    """`ops.attention_sm90.rel_attention` in MODE_PARTIAL (fp32 `out`
+    `(S, T, H, D)` and log2 `lse` `(S, T, H)` partials) or MODE_OUT_LSE (fp32
+    `out` `(T, H, D)` and natural-log `lse` `(H, T)`, one split); `rel_logits`
+    None is the DSpark draft, `window` 0 a full layer. A block holds the whole
+    tokens of 16, 32 or 64 rows (tokens x heads per KV head): the fewest warps
+    that take a request's tokens (decode), `prefill_warps` for prefill. `lib`
+    and `warps` are for tests (a CPU build of the kernel takes CPU tensors)."""
+    lib = lib or _library()
+    assert lib is not None
+    num_tokens, num_heads, head_dim = q.shape
+    page, num_kv_heads = key_cache.shape[1:3]
+    group = num_heads // num_kv_heads
+    assert head_dim == HEAD_DIM and q.dtype == torch.float16
+    assert num_heads % num_kv_heads == 0 and group <= ROWS
+    assert q.stride(1) == head_dim and q.stride(2) == 1
+    assert key_cache.stride() == value_cache.stride() and key_cache.stride(3) == 1
+    assert key_cache.element_size() == 1 and page & (page - 1) == 0
+    # The kernel reads the cache in 32-bit words.
+    assert key_cache.data_ptr() % 4 == 0 and value_cache.data_ptr() % 4 == 0
+    assert all(stride % 4 == 0 for stride in key_cache.stride()[:3])
+    assert out.dtype == lse.dtype == torch.float32
+    out_strides = (0, 0, 0, 0)
+    if mode == MODE_PARTIAL:
+        assert out.is_contiguous() and lse.is_contiguous()
+        assert out.shape == (num_splits, num_tokens, num_heads, head_dim)
+        assert lse.shape == (num_splits, num_tokens, num_heads)
+    else:
+        assert mode == MODE_OUT_LSE and num_splits == 1 and out.stride(2) == 1
+        out_strides = (out.stride(0), out.stride(1), lse.stride(0), lse.stride(1))
+    for index in (block_table, cache_seqlens, cu_seqlens_q):
+        assert index.dtype == torch.int32
+    assert cache_seqlens.stride(0) == 1 and cu_seqlens_q.stride(0) == 1
+    assert block_table.stride(1) == 1
+    extent = 0
+    rel = q
+    if rel_logits is not None:
+        extent = rel_logits.shape[2] - 256
+        assert rel_logits.dtype == torch.float16
+        assert rel_logits.stride(1) == rel_logits.shape[2]
+        assert rel_logits.stride(2) == 1
+        rel = rel_logits
+    if warps is None:
+        if mode == MODE_PARTIAL:
+            warps = decode_warps(max_query_len, group)
+        else:
+            warps = prefill_warps(window)
+    assert warps in (1, 2, 4, 8)
+    tokens_per_block = warps * ROWS // group
+    args = _Args(
+        q=q.data_ptr(),
+        k=key_cache.data_ptr(),
+        v=value_cache.data_ptr(),
+        rel=rel.data_ptr(),
+        block_table=block_table.data_ptr(),
+        seq_lens=cache_seqlens.data_ptr(),
+        cu_seqlens_q=cu_seqlens_q.data_ptr(),
+        out=out.data_ptr(),
+        lse=lse.data_ptr(),
+        stride_q_t=q.stride(0),
+        stride_kv_blk=key_cache.stride(0),
+        stride_kv_slot=key_cache.stride(1),
+        stride_kv_h=key_cache.stride(2),
+        stride_rel_t=rel.stride(0),
+        stride_bt=block_table.stride(0),
+        stride_out_t=out_strides[0],
+        stride_out_h=out_strides[1],
+        stride_lse_h=out_strides[2],
+        stride_lse_t=out_strides[3],
+        softmax_scale=softmax_scale,
+        num_tokens=num_tokens,
+        num_splits=num_splits,
+        num_kv_heads=num_kv_heads,
+        num_heads=num_heads,
+        group=group,
+        extent=extent,
+        page=page,
+        page_shift=page.bit_length() - 1,
+        window=window,
+        draft=rel_logits is None,
+        mode=mode,
+    )
+    stream = torch.cuda.current_stream(q.device).cuda_stream if q.is_cuda else 0
+    error = lib.hi_sm75_rel_attention(
+        ctypes.byref(args),
+        cache_seqlens.shape[0],
+        -(-max_query_len // tokens_per_block),
+        warps,
+        ctypes.c_void_p(stream),
+    )
+    if error:
+        raise RuntimeError(f"hi_sm75_rel_attention: CUDA error {error}")
