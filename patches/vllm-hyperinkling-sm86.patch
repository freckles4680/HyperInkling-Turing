+        {k: torch.cat([b[i] for b in buf]) for i, k in enumerate(("x", "ids", "w"))},
+        os.path.join(_CAPTURE_DIR, f"{name}_{chunk:04d}.pt"),
+    )
+
+
+def capture_flush_all() -> None:
+    """Writes every partial capture buffer."""
+    for name in list(_capture_buffers):
