index 0000000000..9103f9b745
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/lookup.py
@@ -0,0 +1,233 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Drafting from the request's own context (HYPERINKLING_LOOKUP=1).
+
+The DSpark drafter sees a 1024-token window; a document the answer quotes can be
+far beyond it. One Triton program per request finds the most recent occurrence of
+the longest suffix (up to NMAX tokens) of the token history; a match of `nmin`
+tokens or more replaces the drafts with the tokens that followed it.
+
+Lossless: every position taken from the lookup gets a point mass on the proposed
+token in the draft-logits cache, a legal q for the rejection sampler (acceptance
+becomes p(x)). Whether to take it must depend on the history only, never on the
+sampled drafts: choosing after seeing them leaves drafts that no longer follow
+their q, and the output no longer follows p.
+
+After HyperQwen's dflash2-lookup-drafting (syv-ai/HyperQwen, Apache-2.0).
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+# "Longest match, then most recent" as one max over len * SCORE_STRIDE + end index.
+SCORE_STRIDE = tl.constexpr(1 << 32)
+
+
+@triton.jit
+def _suffix_lookup_kernel(
+    tokens_ptr,
+    tokens_stride,
+    total_len_ptr,
+    idx_mapping_ptr,
+    idx_mapping_stride,
+    out_tokens_ptr,
+    out_len_ptr,
+    out_valid_ptr,
+    search_max,
+    K: tl.constexpr,
+    NMAX: tl.constexpr,
+    NMIN: tl.constexpr,
+    BLOCK: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    req = tl.program_id(0)
+    tl.store(out_len_ptr + req, 0)
+    tl.store(out_valid_ptr + req, 0)
+    req_state = tl.load(idx_mapping_ptr + req * idx_mapping_stride)
+    if req_state < 0:
+        return
+    total_len = tl.load(total_len_ptr + req_state)
+    if total_len < NMIN + 2:
+        return
+    base = tokens_ptr + req_state.to(tl.int64) * tokens_stride
+    end_of_suffix = total_len - 1
+    # Candidate ends before the suffix's own end; a candidate may overlap the suffix, so
+    # a repeating pattern (a list marker, an indent) is proposed from its own period.
+    hi = end_of_suffix
+    lo = tl.maximum(NMIN - 1, total_len - search_max)
+    best = tl.full([], -1, tl.int64)
+    for start in range(lo, hi, BLOCK):
+        e = start + tl.arange(0, BLOCK)
+        alive = (e < hi) & (e >= lo)
+        # The NMIN-token prefix first: most blocks die here.
+        for j in range(NMIN):
+            s_j = tl.load(base + end_of_suffix - j)
+            t_j = tl.load(base + e - j, mask=alive & ((e - j) >= 0), other=-1)
+            alive = alive & (t_j == s_j)
+        if tl.max(alive.to(tl.int32)) > 0:
+            match = tl.where(alive, NMIN, 0)
+            longer = alive
+            for j in range(NMIN, NMAX):
+                s_j = tl.load(
+                    base + end_of_suffix - j, mask=(end_of_suffix - j) >= 0, other=-2
+                )
+                t_j = tl.load(base + e - j, mask=longer & ((e - j) >= 0), other=-1)
+                longer = longer & (t_j == s_j)
+                match = tl.where(longer, match + 1, match)
+            score = tl.where(
+                alive, match.to(tl.int64) * SCORE_STRIDE + e.to(tl.int64), -1
+            )
+            best = tl.maximum(best, tl.max(score, axis=0))
+    if best < 0:
+        return
+    end = (best % SCORE_STRIDE).to(tl.int32)
+    # A match close to the suffix has fewer than K tokens after it.
+    valid = tl.minimum(K, end_of_suffix - end)
+    idx = tl.arange(0, BLOCK_K)
+    toks = tl.load(base + end + 1 + idx, mask=idx < valid, other=0)
+    tl.store(out_tokens_ptr + req * K + idx, toks, mask=idx < K)
+    tl.store(out_len_ptr + req, (best // SCORE_STRIDE).to(tl.int32))
+    tl.store(out_valid_ptr + req, valid)
+
+
+@triton.jit
+def _fuse_kernel(
+    draft_ptr,
+    draft_stride,
+    look_ptr,
+    len_ptr,
+    valid_ptr,
+    used_ptr,
+    idx_mapping_ptr,
+    idx_mapping_stride,
+    nmin,
+    K: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    """One program per request: decide, then write the taken positions. `used` holds how
+    many leading positions came from the lookup (0: none)."""
+    req = tl.program_id(0)
+    tl.store(used_ptr + req, 0)
+    req_state = tl.load(idx_mapping_ptr + req * idx_mapping_stride)
+    if req_state < 0:
+        return
+    idx = tl.arange(0, BLOCK_K)
+    kmask = idx < K
+    match_len = tl.load(len_ptr + req)
+    valid = tl.load(valid_ptr + req)
+    looked = tl.load(look_ptr + req * K + idx, mask=kmask, other=0).to(tl.int64)
+    if (match_len >= nmin) & (valid > 0):
+        tl.store(
+            draft_ptr + req * draft_stride + idx, looked, mask=kmask & (idx < valid)
+        )
+        tl.store(used_ptr + req, valid)
+
+
+@triton.jit
+def _point_mass_kernel(
+    draft_ptr,
+    draft_stride,
+    used_ptr,
+    idx_mapping_ptr,
+    idx_mapping_stride,
+    cache_ptr,
+    cache_stride_row,
+    cache_stride_step,
+    vocab,
+    BLOCK_V: tl.constexpr,
+):
+    """Grid (requests, K): the draft-logits row of each taken position becomes a
+    point mass on the token now in `draft_tokens`."""
+    req = tl.program_id(0)
+    step = tl.program_id(1)
+    req_state = tl.load(idx_mapping_ptr + req * idx_mapping_stride)
+    if (req_state < 0) | (step >= tl.load(used_ptr + req)):
+        return
+    token = tl.load(draft_ptr + req * draft_stride + step)
+    row = (
+        cache_ptr + req_state.to(tl.int64) * cache_stride_row + step * cache_stride_step
+    )
+    for v0 in range(0, vocab, BLOCK_V):
+        offs = v0 + tl.arange(0, BLOCK_V)
+        tl.store(row + offs, float("-inf"), mask=offs < vocab)
+    tl.store(row + token, 0.0)
+
+
+class ContextLookup:
+    """Persistent buffers for one speculator (CUDA-graph safe: no host reads)."""
+
+    def __init__(
+        self,
+        max_num_reqs: int,
+        k: int,
+        device: torch.device,
+        nmin: int = 8,
+        nmax: int = 32,
+        search_max: int = 1 << 30,
+    ):
+        self.k, self.nmin = k, nmin
+        self.nmax, self.search_max = nmax, search_max
+        self.tokens = torch.zeros(max_num_reqs, k, dtype=torch.int32, device=device)
+        self.match_len = torch.zeros(max_num_reqs, dtype=torch.int32, device=device)
+        self.valid = torch.zeros(max_num_reqs, dtype=torch.int32, device=device)
+        # Per request: how many leading drafts came from the lookup this step.
+        self.used = torch.zeros(max_num_reqs, dtype=torch.int32, device=device)
+
+    def apply(
+        self,
+        token_history: torch.Tensor,
+        total_len: torch.Tensor,
+        idx_mapping: torch.Tensor,
+        idx_mapping_stride: int,
+        num_reqs: int,
+        draft_tokens: torch.Tensor,
+        draft_logits: torch.Tensor | None,
+    ) -> None:
+        """`draft_tokens[:num_reqs]` <- the fused proposal; `draft_logits` (the
+        [rows, K, vocab] cache indexed by request state) <- point masses where taken."""
+        _suffix_lookup_kernel[(num_reqs,)](
+            token_history,
+            token_history.stride(0),
+            total_len,
+            idx_mapping,
+            idx_mapping_stride,
+            self.tokens,
+            self.match_len,
+            self.valid,
+            self.search_max,
+            K=self.k,
+            NMAX=self.nmax,
+            NMIN=min(self.nmin, 4),
+            BLOCK=1024,
+            BLOCK_K=triton.next_power_of_2(self.k),
+            num_warps=4,
+        )
+        _fuse_kernel[(num_reqs,)](
+            draft_tokens,
+            draft_tokens.stride(0),
+            self.tokens,
+            self.match_len,
+            self.valid,
+            self.used,
+            idx_mapping,
+            idx_mapping_stride,
+            self.nmin,
+            K=self.k,
+            BLOCK_K=triton.next_power_of_2(self.k),
+            num_warps=1,
+        )
+        if draft_logits is not None:
+            _point_mass_kernel[(num_reqs, self.k)](
+                draft_tokens,
+                draft_tokens.stride(0),
+                self.used,
+                idx_mapping,
+                idx_mapping_stride,
+                draft_logits,
+                draft_logits.stride(0),
+                draft_logits.stride(1),
+                draft_logits.shape[-1],
+                BLOCK_V=4096,
+                num_warps=4,
+            )
