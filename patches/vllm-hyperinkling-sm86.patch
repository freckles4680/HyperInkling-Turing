+class SconvStateManager(DFlashSlidingWindowManager):
+    """Conv-state cache that backs only each step's tail.
+
+    The conv reads cached taps only for the first `W - 1` tokens of a step
+    (later taps come from the step's own inputs), so a step needs real blocks
+    just for its last tokens: the window, the drafts in flight that may be
+    rejected, and one hit alignment so that a prefix hit at the aligned
+    position below the step's end finds its window. The rest of a prefill
+    chunk is null, except the window below the request's shared-prefix
+    junction, where requests with the same prefix resume. Hits use the plain
+    sliding-window rule (`h` needs the window before `h`): they land where a
+    step ended or at a junction.
+    """
+
+    @dataclass(frozen=True, slots=True)
+    class Params(DFlashSlidingWindowManager.Params):
+        hit_alignment_tokens: int = 0
+
+        @property
+        def tail_tokens(self) -> int:
+            return (
+                self.sliding_window
+                + self.num_speculative_tokens * self.max_in_flight_steps
+                + self.hit_alignment_tokens
+            )
+
+    find_longest_cache_hit = SlidingWindowManager.__dict__["find_longest_cache_hit"]
+    reachable_block_mask = SlidingWindowManager.__dict__["reachable_block_mask"]
+
+    def __init__(self, kv_cache_group: KVCacheGroup, **kwargs) -> None:
+        super().__init__(kv_cache_group, **kwargs)
+        params = self.manager_config.params
+        assert isinstance(params, SconvStateManager.Params)
+        assert self.cache_hit_alignment_tokens <= params.hit_alignment_tokens, (
+            "conv-state tails shorter than the prefix-hit alignment"
+        )
+        # req_id -> block range of the window below its shared-prefix junction.
+        self._junction_blocks: dict[str, range] = {}
+
+    @classmethod
+    def max_admission_blocks(
+        cls,
+        config: ManagerConfig,
