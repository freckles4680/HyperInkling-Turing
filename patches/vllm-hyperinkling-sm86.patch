+def _is_cors_preflight(scope: Scope, headers: Headers) -> bool:
+    """CORSMiddleware's own preflight test. Without Origin the request reaches the app,
+    and mounts such as /metrics answer any method, so a bare OPTIONS needs the key."""
+    return (
