+            x[keep].cpu(),
+            ids[keep].to(torch.int16).cpu(),
+            weights.view(ids.shape)[keep].to(torch.float16).cpu(),
+        )
+    )
+    if sum(b[0].shape[0] for b in buf) >= _CAPTURE_FLUSH_TOKENS:
