# HyperInkling settings. `python3 scripts/wizard.py` writes .env for you; or copy this file
# to .env and edit. Every variable of start.sh works here. Values: a 22 GB RTX 2080 Ti
# (Turing), as scripts/serve.sh; context gains marked "3090 Ti" were measured upstream.
# Contexts below: KV cache at 8 bits, measured on the 2080 Ti headless at 1 request.

# --- Serving -------------------------------------------------------------------------
# Requests served at once (1-64). Fewer leave a little more room for the longest request.
# 2 = one chat plus the side requests front ends send (titles, tags).
MAX_SEQS=2
# Longest request, in tokens: auto = what the GPU holds (~145k headless, ~120k with a desktop
# on the card); a number
# caps it, and the boot fails if it does not fit.
MAX_LEN=auto
# Port on the host (Docker publishes it); BIND=0.0.0.0 serves other machines, together
# with VLLM_API_KEY. Native start.sh: HOST=0.0.0.0 instead of BIND.
PORT=8080
BIND=127.0.0.1
# VLLM_API_KEY=

# --- Speed -----------------------------------------------------------------------------
# DSpark speculative decoding (lossless): 2.7-3.6 tokens a step, ~84-93 tok/s for one request
# on the 2080 Ti; it costs context (~78k tokens on a 3090 Ti). SPEC=off for the longest
# contexts.
SPEC=dspark
# Async scheduling, 1 or 0. Off: ~17k tokens more, -3 to -4% decode (3090 Ti).
ASYNC=1
# Most tokens of one prompt per step while other requests are there; 0 = no limit.
# Empty: half of NBT.
LONG_PREFILL=

# --- Images ----------------------------------------------------------------------------
# Images per request; 0 = no vision tower (~37k tokens more on a 3090 Ti, text only).
IMAGES=50
# Vision tower weights in host RAM instead of on the GPU: ~36k tokens more, +27 ms per page
# (3090 Ti; not measured on Turing).
HYPERINKLING_VISION_HOST=0
# Largest image (1,014 tokens, A4 at ~126 ppi); larger ones are scaled down to it.
IMAGE_MAX_W=1040
IMAGE_MAX_H=1560

# --- Memory ----------------------------------------------------------------------------
# Prefix cache tier in host RAM (/dev/shm), GiB; 0 = off (the safe choice with 32 GB of RAM;
# auto sizes it from RAM on machines with more). Docker: SHM_GB must exceed it.
KV_OFFLOAD_GB=0
SHM_GB=48
# Fraction of the GPU memory vLLM takes; lower it by ~0.045 per GiB a display uses (a desktop
# on the 2080 Ti took ~0.5 GiB).
GPU_UTIL=0.95
